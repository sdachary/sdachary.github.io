/* --- Editorial warm cream identity (replaces dark palette) --- */
:root {
  --bg: #f6f2ea;
  --bg2: #ede9dc;
  --white: #181410;
  --muted: #6e6355;
  --accent: #8b6e4e;
  --accent2: #4a6b5e;
  --line: rgba(24,20,16,0.10);
  --font-display: 'Playfair Display', Georgia, 'Times New Roman', serif;
  --font-body: 'Geist', system-ui, -apple-system, sans-serif;
  --font-mono: 'DM Mono', ui-monospace, monospace;
  --ease-smooth: cubic-bezier(0.32, 0.72, 0, 1);
  --noise-opacity: 0.04;
  --nav-bg: rgba(246,242,234,0.92);
  --nav-border: rgba(24,20,16,0.08);
  --card-bg: rgba(237,233,220,0.60);
  --card-bg2: rgba(24,20,16,0.03);
  --card-hover-bg: rgba(139,110,78,0.06);
  --card-shadow: 0 8px 32px rgba(24,20,16,0.08);
  --card-shadow-lg: 0 16px 48px rgba(24,20,16,0.10);
  --blog-shadow: 0 4px 20px rgba(24,20,16,0.06);
  --skill-card-bg: rgba(24,20,16,0.03);
  --hero-overlay: linear-gradient(180deg, rgba(246,242,234,0.55) 0%, rgba(246,242,234,0.92) 70%);
  --icon-bg: rgba(24,20,16,0.06);
}

[data-theme="light"], [data-theme="dark"] {
  --bg: #f6f2ea; --bg2: #ede9dc; --white: #181410; --muted: #6e6355;
  --accent: #8b6e4e; --accent2: #4a6b5e; --line: rgba(24,20,16,0.10);
  --noise-opacity: 0.04; --nav-bg: rgba(246,242,234,0.92); --nav-border: rgba(24,20,16,0.08);
  --card-bg: rgba(237,233,220,0.60); --card-bg2: rgba(24,20,16,0.03);
  --card-hover-bg: rgba(139,110,78,0.06); --card-shadow: 0 8px 32px rgba(24,20,16,0.08);
  --card-shadow-lg: 0 16px 48px rgba(24,20,16,0.10); --blog-shadow: 0 4px 20px rgba(24,20,16,0.06);
  --skill-card-bg: rgba(24,20,16,0.03); --hero-overlay: linear-gradient(180deg, rgba(246,242,234,0.55) 0%, rgba(246,242,234,0.92) 70%);
  --icon-bg: rgba(24,20,16,0.06);
}
