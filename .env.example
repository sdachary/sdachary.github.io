# Portfolio — Environment Variables
# Copy to .env.local for local development

# n8n contact webhook (full URL incl. token). URL is auto-assigned by Render
# on each service create — keep in GitHub repo secret N8N_WEBHOOK_URL, not in git.
VITE_N8N_WEBHOOK_URL=https://indra-<slug>.onrender.com/webhook/portfolio-contact?token=<token>
